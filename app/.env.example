# Iron Front Digital — legacy app/ server environment variables
#
# This is the legacy Node http server (Stripe checkout + magic-link
# auth + leads SQLite). Most of the system has moved to operator-ui/;
# see operator-ui/ENV_VARIABLES.md for the comprehensive reference.

# ============================================================================
# REQUIRED
# ============================================================================

# Build version stamp. Server hard-fails on startup if missing — set this
# from your deploy pipeline (e.g. APP_VERSION=$(git rev-parse --short HEAD)).
APP_VERSION=

# Postgres for shared auth tables (users, sessions, magic_links).
# Both apps share one database.
DATABASE_URL=postgresql://user:password@host:5432/ifd

# Required for /admin/* endpoints. Sent as the x-admin-key header.
ADMIN_KEY=replace_with_random_string

# ============================================================================
# OPTIONAL
# ============================================================================

# HTTP listen port. Default 3000.
# PORT=3000

# SQLite path for the legacy leads + events tables. Mount as a durable
# volume in production (the deploy script sets this to /data/ifd.db).
# DB_PATH=/data/ifd.db

# When unset, /apply skips Stripe customer creation but still records
# the lead in SQLite. Same key as the Next.js app uses.
# STRIPE_SECRET_KEY=sk_test_replace_me

# When 'production', login session cookie gets the Secure flag.
# NODE_ENV=production
