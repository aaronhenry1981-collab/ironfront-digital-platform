# Iron Front Digital — operator-ui environment variables
#
# Copy to .env.local and fill in. See ENV_VARIABLES.md for the full
# reference (what's required, what's optional, what gracefully degrades
# when unset, and the AWS-side setup needed for SES + inbound).
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# ============================================================================
# DATABASE (required)
# ============================================================================

DATABASE_URL=postgresql://user:password@host:5432/ifd

# ============================================================================
# AUTHENTICATION
# ============================================================================

# Override only if you've changed the seeded org id.
# INTAKE_ORG_ID=00000000-0000-0000-0000-000000000002

# ============================================================================
# APP URL (required)
# ============================================================================

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# STRIPE (required for billing)
# ============================================================================

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

NEXT_PUBLIC_STRIPE_PRICE_STARTER_MONTHLY=price_replace_me
NEXT_PUBLIC_STRIPE_PRICE_GROWTH_MONTHLY=price_replace_me
NEXT_PUBLIC_STRIPE_PRICE_SCALE_MONTHLY=price_replace_me
NEXT_PUBLIC_STRIPE_PRICE_ORGANIZATION_MONTHLY=price_replace_me

NEXT_PUBLIC_STRIPE_PRICE_STARTER_ANNUAL=price_replace_me
NEXT_PUBLIC_STRIPE_PRICE_GROWTH_ANNUAL=price_replace_me
NEXT_PUBLIC_STRIPE_PRICE_SCALE_ANNUAL=price_replace_me
NEXT_PUBLIC_STRIPE_PRICE_ORGANIZATION_ANNUAL=price_replace_me

NEXT_PUBLIC_STRIPE_PRICE_FRANCHISE=price_replace_me

# ============================================================================
# CLAUDE LLM (optional — drafter returns 503 cleanly when unset)
# ============================================================================

# ANTHROPIC_API_KEY=sk-ant-replace_me

# Default is claude-sonnet-4-6. Upgrade to claude-opus-4-7 when ready.
# CLAUDE_MODEL=claude-sonnet-4-6

# ============================================================================
# AWS SES — outbound email (optional — falls back to console.log when unset)
# ============================================================================

# AWS_REGION=us-east-1
# AWS_SES_FROM_EMAIL=Iron Front Digital <hello@ironfrontdigital.com>

# Set this to enable inbound reply threading.
# AWS_SES_REPLY_TO_DOMAIN=operations.ironfrontdigital.com

# ============================================================================
# Inbound email webhook (optional)
# ============================================================================

# Any random long string. Must match the x-inbound-secret header that
# your SES Lambda forwarder sends.
# INBOUND_EMAIL_SECRET=replace_with_random_string

# ============================================================================
# Cron / scheduled jobs (required for cron endpoint)
# ============================================================================

# Any random long string. Required by POST /api/cron/run-jobs.
# CRON_SECRET=replace_with_random_string

# ============================================================================
# Sentry (optional)
# ============================================================================

# SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
